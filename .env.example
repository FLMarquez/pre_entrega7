# Redis (usado tanto para el estado de los jobs como para el checkpointer de LangGraph)
REDIS_URL=redis://localhost:6379/0
JOB_TTL_SECONDS=86400

# Proveedor de LLM: gemini | anthropic | openai
MODEL_PROVIDER=gemini
MODEL_NAME=gemini-2.0-flash

# Si MODEL_PROVIDER=gemini: podés cargar UNA sola key (GEMINI_API_KEY) o varias
# (GEMINI_API_KEY, GEMINI_API_KEY_1, GEMINI_API_KEY_2, ...). Si una se queda sin
# cuota o da rate-limit/key inválida, la app rota automáticamente a la siguiente.
# IMPORTANTE: completar estos valores solo en tu .env local (nunca en este
# archivo .env.example, que sí se commitea).
GEMINI_API_KEY=
GEMINI_API_KEY_1=
GEMINI_API_KEY_2=
GEMINI_API_KEY_3=

# Si MODEL_PROVIDER=anthropic
ANTHROPIC_API_KEY=

# Si MODEL_PROVIDER=openai
OPENAI_API_KEY=

# Observabilidad: langsmith | phoenix | none
OBSERVABILITY_BACKEND=langsmith

# --- LangSmith ---
LANGSMITH_API_KEY=
LANGSMITH_PROJECT=pre-entrega7-multiagent

# --- Arize Phoenix (si OBSERVABILITY_BACKEND=phoenix) ---
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=pre-entrega7-multiagent
